{
  "name": "mortal-jan-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "npm run types && tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:load:local": "wrangler d1 execute DB --local --file ../generated/problems.sql",
    "db:load:logs:local": "wrangler d1 execute DB --local --file ../generated/problem-logs.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.1"
  },
  "allowScripts": {
    "workerd@1.20260926.1": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
