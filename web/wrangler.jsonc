{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mortal-jan",
	"account_id": "2260bae6e0e26ad01b28604c5c7e3a45",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-26",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mortal-jan",
			"database_id": "8f080e86-2a07-4d4f-bf2f-7cab16f322eb",
			"migrations_dir": "./migrations"
		}
	],
	// Keeps one client from spending the D1 free tier (an answer writes about 3 rows).
	"ratelimits": [
		{ "name": "PLAYER_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "ANSWER_LIMITER", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } },
		{ "name": "IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
	],
	// Rankings and players' averages are counted from new answers every 10 minutes.
	"triggers": { "crons": ["*/10 * * * *"] },
	"observability": { "enabled": true }
}
